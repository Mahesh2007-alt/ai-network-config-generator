! ==============================================================================
! Cisco IOS Network Configuration
! Hostname: {{ hostname }}
! Generated by: AI Network Configuration Generator
! ==============================================================================

hostname {{ hostname }}
!
no ip domain-lookup
service timestamps debug datetime msec
service timestamps log datetime msec
!
{% if security %}
! ------------------------------------------------------------------------------
! Device Security & Remote Management
! ------------------------------------------------------------------------------
{% if security.domain_name %}
ip domain-name {{ security.domain_name }}
{% endif %}
{% if security.users %}
{% for u in security.users %}
username {{ u.username }}{% if u.privilege is not none %} privilege {{ u.privilege }}{% endif %} secret {{ u.secret | default(u.password | default('CiscoPass123')) }}
{% endfor %}
{% endif %}
{% if security.rsa_bits %}
crypto key generate rsa modulus {{ security.rsa_bits }}
ip ssh version 2
{% endif %}
{% if security.ssh %}
line vty {{ security.ssh.vty_lines | default('0 4') }}
 {% if security.ssh.transport_input %}
 transport input {{ security.ssh.transport_input }}
 {% endif %}
 {% if security.ssh.login %}
 login {{ security.ssh.login }}
 {% endif %}
exit
!
{% endif %}
{% endif %}
{% if vlans %}
! ------------------------------------------------------------------------------
! Layer 2 VLAN Definitions
! ------------------------------------------------------------------------------
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
exit
!
{% endfor %}
! ------------------------------------------------------------------------------
! Layer 3 Switched Virtual Interfaces (SVIs)
! ------------------------------------------------------------------------------
{% for vlan in vlans %}
interface Vlan{{ vlan.id }}
 description SVI Gateway for {{ vlan.name }}
 ip address {{ vlan.ip }} {{ vlan.subnet_mask }}
 no shutdown
exit
!
{% endfor %}
{% endif %}
{% if interfaces %}
! ------------------------------------------------------------------------------
! Routed & Logical Physical Interfaces
! ------------------------------------------------------------------------------
{% for iface in interfaces %}
interface {{ iface.name }}
 {% if iface.description %}
 description {{ iface.description }}
 {% endif %}
 {% if iface.encapsulation %}
 encapsulation {{ iface.encapsulation }}
 {% elif iface.vlan_id %}
 encapsulation dot1Q {{ iface.vlan_id }}
 {% elif '.' in iface.name and iface.name.split('.')[-1].isdigit() %}
 encapsulation dot1Q {{ iface.name.split('.')[-1] }}
 {% endif %}
 {% if iface.ip and iface.subnet_mask and (iface.ip | lower not in ['none', 'null', 'unassigned', '']) %}
 ip address {{ iface.ip }} {{ iface.subnet_mask }}
 {% else %}
 no ip address
 {% endif %}
 {% if iface.shutdown %}
 shutdown
 {% else %}
 no shutdown
 {% endif %}
exit
!
{% endfor %}
{% endif %}
{% if routing and routing.protocol | lower == 'ospf' %}
! ------------------------------------------------------------------------------
! Dynamic Routing: OSPF Process {{ routing.process_id | default(1) }}
! ------------------------------------------------------------------------------
router ospf {{ routing.process_id | default(1) }}
 {% if routing.router_id %}
 router-id {{ routing.router_id }}
 {% endif %}
 log-adjacency-changes
 {% for net in routing.networks | default([]) %}
 network {{ net.network_ip }} {{ net.wildcard_mask }} area {{ net.area }}
 {% endfor %}
exit
!
{% endif %}
{% if routing and routing.protocol | lower == 'bgp' %}
! ------------------------------------------------------------------------------
! Dynamic Routing: BGP Autonomous System {{ routing.as_number | default(routing.asn | default(65000)) }}
! ------------------------------------------------------------------------------
router bgp {{ routing.as_number | default(routing.asn | default(65000)) }}
 {% if routing.router_id %}
 bgp router-id {{ routing.router_id }}
 {% endif %}
 bgp log-neighbor-changes
 {% for neighbor in routing.neighbors | default([]) %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.remote_as }}
  {% if neighbor.description %}
  neighbor {{ neighbor.ip }} description {{ neighbor.description }}
  {% endif %}
  {% if neighbor.update_source %}
  neighbor {{ neighbor.ip }} update-source {{ neighbor.update_source }}
  {% endif %}
 {% endfor %}
 {% for net in routing.networks | default([]) %}
 network {{ net.network_ip }} mask {{ net.subnet_mask | default('255.255.255.0') }}
 {% endfor %}
exit
!
{% endif %}
{% if routing and routing.static_routes %}
! ------------------------------------------------------------------------------
! Static Routing
! ------------------------------------------------------------------------------
{% for route in routing.static_routes %}
ip route {{ route.prefix | default('0.0.0.0') }} {{ route.mask | default('0.0.0.0') }} {{ route.next_hop }}
{% endfor %}
!
{% endif %}
{% if acls %}
! ------------------------------------------------------------------------------
! Access Control Lists (ACLs)
! ------------------------------------------------------------------------------
{% for acl in acls %}
{% set acl_type = acl.type | default('extended') | lower %}
{% if acl_type == 'standard' %}
ip access-list standard {{ acl.name }}
 {% for rule in acl.rules %}
 {{ rule.action | lower }} {{ rule.source | default('any') }}{% if rule.wildcard_mask %} {{ rule.wildcard_mask }}{% endif %}
 {% endfor %}
exit
!
{% else %}
ip access-list extended {{ acl.name }}
 {% for rule in acl.rules %}
 {{ rule.action | lower }} {{ rule.protocol | default('ip') }} {{ rule.source | default('any') }} {{ rule.destination | default('any') }}{% if rule.port %} eq {{ rule.port }}{% endif %}
 {% endfor %}
exit
!
{% endif %}
{% endfor %}
{% endif %}
!
end
write memory
