# ==============================================================================
# Juniper Junos Network Configuration (Set-Command Syntax)
# Hostname: {{ hostname }}
# Generated by: AI Network Configuration Generator
# ==============================================================================

# ------------------------------------------------------------------------------
# System Hostname & Global Settings
# ------------------------------------------------------------------------------
set system host-name {{ hostname }}
{% if security %}
{% if security.domain_name %}
set system domain-name {{ security.domain_name }}
{% endif %}
{% if security.users %}
{% for u in security.users %}
set system login user {{ u.username }} class super-user authentication plain-text-password {{ u.secret | default(u.password | default('CiscoPass123')) }}
{% endfor %}
{% endif %}
{% endif %}
set system services ssh

{% if vlans %}
# ------------------------------------------------------------------------------
# VLAN Definitions & Layer-3 IRB Binding
# ------------------------------------------------------------------------------
{% for vlan in vlans %}
set vlans {{ vlan.name }} vlan-id {{ vlan.id }}
set vlans {{ vlan.name }} l3-interface irb.{{ vlan.id }}
{% endfor %}

# ------------------------------------------------------------------------------
# Integrated Routing & Bridging (IRB) Interfaces
# ------------------------------------------------------------------------------
{% for vlan in vlans %}
set interfaces irb unit {{ vlan.id }} description "Gateway for {{ vlan.name }}"
set interfaces irb unit {{ vlan.id }} family inet address {{ vlan.ip }}/{{ vlan.cidr }}
{% endfor %}
{% endif %}

{% if interfaces %}
# ------------------------------------------------------------------------------
# Physical & Logical Routed Interfaces
# ------------------------------------------------------------------------------
{% for iface in interfaces %}
{% set j_port = iface.name | junos_port %}
{% set is_subif = '.' in iface.name or iface.vlan_id or iface.encapsulation %}
{% set j_unit = (iface.name | junos_unit) if is_subif else '0' %}
{% set vlan_val = iface.vlan_id | default(j_unit if is_subif else None) %}
{% set is_unnumbered = not iface.ip or (iface.ip | lower in ['none', 'null', 'unassigned', '']) %}
{% if is_unnumbered %}
{% if iface.description %}
set interfaces {{ j_port }} description "{{ iface.description }}"
{% endif %}
set interfaces {{ j_port }} vlan-tagging
{% else %}
{% if iface.description %}
set interfaces {{ j_port }} unit {{ j_unit }} description "{{ iface.description }}"
{% endif %}
{% if is_subif and vlan_val %}
set interfaces {{ j_port }} unit {{ j_unit }} vlan-id {{ vlan_val }}
{% endif %}
set interfaces {{ j_port }} unit {{ j_unit }} family inet address {{ iface.ip }}/{{ iface.cidr | default(24) }}
{% endif %}
{% endfor %}
{% endif %}

# ------------------------------------------------------------------------------
# Routing Protocols (OSPF)
# ------------------------------------------------------------------------------
{% if routing and routing.protocol | lower == 'ospf' %}
{% set processed_areas = [] %}
{% for net in routing.networks | default([]) %}
{% set area_val = net.area | string %}
{% if '.' not in area_val and (net.area | int) < 256 %}
{% set area_str = '0.0.0.' ~ area_val %}
{% else %}
{% set area_str = area_val %}
{% endif %}
{% if area_str not in processed_areas %}
{% set _ = processed_areas.append(area_str) %}
{% for vlan in vlans | default([]) %}
set protocols ospf area {{ area_str }} interface irb.{{ vlan.id }}
{% endfor %}
{% for iface in interfaces | default([]) %}
{% set j_if = iface.name | junos_interface %}
set protocols ospf area {{ area_str }} interface {{ j_if }}.0
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# ------------------------------------------------------------------------------
# Routing Protocols (BGP)
# ------------------------------------------------------------------------------
{% if routing and routing.protocol | lower == 'bgp' %}
{% set asn = routing.as_number | default(routing.asn | default(65000)) %}
set routing-options autonomous-system {{ asn }}
{% if routing.router_id %}
set routing-options router-id {{ routing.router_id }}
{% endif %}
{% for neighbor in routing.neighbors | default([]) %}
set protocols bgp group EXTERNAL type external
set protocols bgp group EXTERNAL peer-as {{ neighbor.remote_as }}
set protocols bgp group EXTERNAL neighbor {{ neighbor.ip }}
{% endfor %}
{% endif %}

# ------------------------------------------------------------------------------
# Static Routing
# ------------------------------------------------------------------------------
{% if routing and routing.static_routes %}
{% for route in routing.static_routes %}
set routing-options static route {{ route.prefix }}/{{ route.cidr | default(24) }} next-hop {{ route.next_hop }}
{% endfor %}
{% endif %}

# ------------------------------------------------------------------------------
# Firewall Filters (Access Lists)
# ------------------------------------------------------------------------------
{% if acls %}
{% for acl in acls %}
{% for rule in acl.rules %}
{% set term_name = "rule_" ~ loop.index %}
{% if rule.source and rule.source != 'any' %}
set firewall family inet filter {{ acl.name }} term {{ term_name }} from source-address {{ rule.source | junos_prefix }}
{% endif %}
{% if rule.destination and rule.destination != 'any' %}
set firewall family inet filter {{ acl.name }} term {{ term_name }} from destination-address {{ rule.destination | junos_prefix }}
{% endif %}
{% if rule.port %}
set firewall family inet filter {{ acl.name }} term {{ term_name }} from destination-port {{ rule.port }}
{% endif %}
{% if rule.protocol and rule.protocol != 'ip' %}
set firewall family inet filter {{ acl.name }} term {{ term_name }} from protocol {{ rule.protocol }}
{% endif %}
set firewall family inet filter {{ acl.name }} term {{ term_name }} then {{ 'accept' if rule.action | lower == 'permit' else 'discard' }}
{% endfor %}
set firewall family inet filter {{ acl.name }} term default-deny then discard
{% endfor %}
{% endif %}
